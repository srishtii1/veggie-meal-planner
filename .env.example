# --- Gemini via Google AI Studio (default for local dev) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-key

# --- Or Gemini via Vertex AI ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- App config ---
VMP_MODEL=gemini-3.5-flash
VMP_SESSION_BACKEND=sqlite            # memory | sqlite | vertex
VMP_DB_URL=sqlite+aiosqlite:///./data/veggie_planner.db
VMP_LOG_LEVEL=INFO
VMP_LOG_JSON=true

# --- Observability ---
# Set to ship traces/metrics to Jaeger or any OTLP collector (docker compose does this).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=veggie-meal-planner
VMP_TRACE_CONSOLE=false               # true = dump spans to stderr

# --- Safety / privacy ---
VMP_REQUIRE_CONFIRMATION=true         # human approval for plan edits, bans, loosening allergies
VMP_REDACT_PII=true                   # scrub PII from logs, spans and long-term memory
VMP_CAPTURE_CONTENT_IN_SPANS=false    # let ADK put prompts/responses into spans (still redacted)

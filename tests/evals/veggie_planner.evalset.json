          "intermediate_data": {"tool_uses": [{"name": "get_user_profile", "args": {}}], "intermediate_responses": []}
        }
      ],
      "session_input": {"app_name": "veggie_meal_planner", "user_id": "eval-user", "state": {}}
    },
    {
